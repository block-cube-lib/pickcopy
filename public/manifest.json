{
  "manifest_version": 3,
  "name": "PickCopy",
  "version": "1.0.0",
  "description": "Pick elements on a page and copy them in your own format — per-site rules, one click",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
